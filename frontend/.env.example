# Salin ke .env.local lalu sesuaikan. Semua variabel dibaca lewat src/config/env.js.

# local = data demo di localStorage (default) | api = Laravel API
VITE_DATA_SOURCE=local

# Base URL Laravel API (termasuk prefix versi)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# URL landing page (project landing/, di-deploy terpisah)
VITE_LANDING_URL=http://localhost:3001

# Timeout request (ms)
VITE_API_TIMEOUT_MS=15000
