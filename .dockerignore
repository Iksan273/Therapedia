# Konteks build Docker butuh backend/, frontend/ (di-build jadi SPA di image web), dan docker/.
# Dokumen, landing/, dan sisanya tidak masuk image.
*
!backend
!frontend
!docker

# Jangan bawa dependency/artefak lokal, rahasia, atau data runtime ke dalam image
backend/vendor
backend/node_modules
backend/.env
backend/.env.*
!backend/.env.example
backend/.git
backend/storage/logs/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/app/*
backend/bootstrap/cache/*.php
backend/public/hot
backend/public/storage
backend/tests

frontend/node_modules
frontend/dist
frontend/build
frontend/coverage
frontend/.env
frontend/.env.*
!frontend/.env.example
**/.DS_Store
