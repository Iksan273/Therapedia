# Env Laravel untuk DEV Docker. Salin ke backend/.env setelah `make laravel-new`:
#   cp docker/env/backend.dev.env.example backend/.env && make artisan c="key:generate"
# Bagian ini menimpa isi .env bawaan Laravel (ganti seluruh isinya).

APP_NAME=Therapedia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Database (service `mysql` di docker-compose.yml; nilai sama dengan .env root)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=therapedia
DB_USERNAME=therapedia
DB_PASSWORD=ganti-password-db

# --- Tanpa Redis dan tanpa queue worker (keputusan proyek): semua sinkron, cache/session di MySQL
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email OTP lupa password -> ditangkap Mailpit (docker compose --profile tools up -d, UI http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@therapedia.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend (Vite dev server) untuk CORS / Sanctum
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
