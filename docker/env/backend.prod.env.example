# Env Laravel untuk UAT/produksi di VPS. Salin ke .env.backend di folder deploy VPS (TIDAK masuk git):
#   cp docker/env/backend.prod.env.example .env.backend
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show   -> tempel ke APP_KEY
# Berkas ini dibaca container lewat env_file, jadi nilai ber-spasi atau karakter khusus ditulis dalam tanda kutip.

APP_NAME=Therapedia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-uat.contoh.com
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (service `mysql`; samakan dengan MYSQL_* di .env root)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=therapedia
DB_USERNAME=therapedia
DB_PASSWORD=ganti-password-db

# --- Tanpa Redis dan tanpa queue worker: semua sinkron, cache/session di MySQL
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email OTP lupa password (SMTP sinkron setelah commit, timeout 10 dtk; gagal -> 503)
MAIL_MAILER=smtp
MAIL_HOST=smtp.contoh.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@contoh.com"
MAIL_FROM_NAME="Therapedia"

# --- Frontend (Vercel) untuk CORS. Token Sanctum dikirim via header Authorization.
FRONTEND_URL=https://uat.contoh.com
