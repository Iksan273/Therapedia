# Env Laravel untuk UAT/produksi di VPS. Salin ke .env.backend di folder deploy VPS (TIDAK masuk git):
#   cp docker/env/backend.prod.env.example .env.backend
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show   -> tempel ke APP_KEY
# Berkas ini dibaca container lewat env_file, jadi nilai ber-spasi atau karakter khusus ditulis dalam tanda kutip.

APP_NAME=Therapedia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Satu origin dengan frontend. Mode IP: http://IP-VPS | domain: https://therapedia.cosmiclabs.tech
APP_URL=https://therapedia.cosmiclabs.tech
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (service `mysql`; samakan dengan MYSQL_* di .env root)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=therapedia
DB_USERNAME=therapedia
DB_PASSWORD=ganti-password-db

# --- Tanpa Redis dan tanpa queue worker: semua sinkron, cache/session di MySQL
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email OTP lupa password (SMTP sinkron setelah commit, timeout 10 dtk; gagal -> 503)
# Laravel 12 memakai MAIL_SCHEME (bukan MAIL_ENCRYPTION): port 465 -> smtps (SSL), port 587 -> smtp (STARTTLS).
# Contoh Hostinger: smtp.hostinger.com, port 465, smtps. MAIL_USERNAME = alamat email lengkap, MAIL_FROM_ADDRESS sama
# dengan MAIL_USERNAME. DNS domain pengirim wajib punya MX + SPF + DKIM (jika tidak: 450 "Sender address rejected").
MAIL_MAILER=smtp
MAIL_HOST=smtp.contoh.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@contoh.com"
MAIL_FROM_NAME="Therapedia"

# --- Akun Master awal (dibuat sekali oleh `php artisan db:seed --force`; tidak menimpa akun yang sudah ada).
# GANTI password bawaan "123" sebelum seeder dijalankan di server: hapus tanda # lalu isi nilainya
# (jangan biarkan terisi kosong: nilai kosong menimpa default dan akun master gagal dibuat).
# SEED_MASTER_EMAIL=master@domainanda.com
# SEED_MASTER_PASSWORD=isi-password-kuat

# --- Frontend satu origin dengan API (disajikan Nginx), jadi tanpa CORS. Isi FRONTEND_URL hanya bila frontend
# dipasang di origin lain. Token Sanctum dikirim via header Authorization.
# FRONTEND_URL=
