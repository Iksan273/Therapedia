# Variabel untuk Docker Compose (dibaca otomatis dari file .env di root repo).
# Salin:  cp .env.example .env   lalu ganti nilai "ganti-...". File .env TIDAK masuk git.
# Env Laravel TERPISAH: dev -> backend/.env, VPS -> .env.backend (contoh di docker/env/).

# ---------------------------------------------------------------- Umum
# Port Nginx di host (dev: http://localhost:8080; VPS: hanya 127.0.0.1, publik lewat proxy)
WEB_PORT=8080
# Alamat bind Nginx di VPS. 127.0.0.1 = tertutup (publik lewat Tunnel/Caddy/proxy). 0.0.0.0 = bisa diakses langsung
# lewat IP VPS (pakai bersama WEB_PORT=80 untuk uji sebelum punya domain; trafik belum terenkripsi)
WEB_BIND=127.0.0.1

# ---------------------------------------------------------------- MySQL (dev dan VPS)
# Harus sama dengan DB_DATABASE / DB_USERNAME / DB_PASSWORD di env Laravel
MYSQL_DATABASE=therapedia
MYSQL_USER=therapedia
MYSQL_PASSWORD=ganti-password-db
MYSQL_ROOT_PASSWORD=ganti-password-root

# ---------------------------------------------------------------- Khusus dev
# Port MySQL yang dibuka ke localhost (untuk DBeaver/TablePlus)
DB_PORT=3307
# UID/GID user host (Linux/Mac: `id -u` dan `id -g`; Windows biarkan 1000)
APP_UID=1000
APP_GID=1000

# ---------------------------------------------------------------- Khusus VPS (UAT/produksi)
# Pemilik repo GitHub, HURUF KECIL (nama image: ghcr.io/<owner>/therapedia-app)
GHCR_OWNER=ganti-username-github
# Tag image yang dijalankan (CI mengisi otomatis dengan SHA commit; `uat` = terbaru)
IMAGE_TAG=uat
# Cara membuka API ke internet (pilih SATU lewat COMPOSE_PROFILES):
#   cloudflare = Cloudflare Tunnel (DIREKOMENDASIKAN dengan Cloudflare: tanpa port terbuka, SSL oleh Cloudflare)
#   tls        = Caddy + Let's Encrypt (port 80/443 terbuka; bila domain di Cloudflare pakai SSL mode Full (strict), lihat panduan §9)
#   (kosong)   = pakai reverse proxy sendiri ke 127.0.0.1:WEB_PORT
COMPOSE_PROFILES=cloudflare
# Token tunnel dari Cloudflare Zero Trust > Networks > Tunnels (hanya untuk profile cloudflare)
CLOUDFLARE_TUNNEL_TOKEN=
# Domain API (hanya untuk profile tls)
APP_DOMAIN=api-uat.contoh.com

# Hanya untuk fallback build image di VPS (`docker compose -f docker-compose.prod.yml build`); build CI memakai
# GitHub Variables dengan nama sama (opsional; default CI = api). local = data demo localStorage (dipakai Vercel) | api = Laravel API
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=/api/v1
VITE_LANDING_URL=

# Backup (docker/scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Opsional salinan off-server, mis. user@host-backup:/backups/therapedia (memakai rsync lewat SSH)
BACKUP_RSYNC_TARGET=
