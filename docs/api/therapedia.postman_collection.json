                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{staff_email}}\",\n  \"otp\": \"123456\",\n  \"password\": \"PasswordBaru123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/reset-password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "reset-password"
                            ]
                        },
                        "description": "Ganti `otp` dengan kode dari email. Sukses 204: password diganti dan SEMUA token akun dihapus (login ulang).\n\nOTP salah/kedaluwarsa/terpakai → 422 pesan generik. 5 kali salah → OTP hangus (minta kode baru). Password baru: minimal 8 karakter, huruf + angka."
                    },
                    "response": []
                }
            ]
        },
